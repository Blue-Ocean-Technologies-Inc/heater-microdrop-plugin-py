[importlinter]
root_packages =
    heater_controller
    heater_controls_ui
    heater_protocol_controls
    device_viewer
    dropbot_controller
    dropbot_preferences_ui
    dropbot_protocol_controls
    dropbot_status_and_controls
    dropbot_tools_menu
    electrode_controller
    logger
    manual_controls
    message_router
    microdrop_application
    microdrop_status_bar
    microdrop_style
    microdrop_utils
    peripheral_device_controller_base
    pluggable_protocol_tree
    plugin_management
    template_status_and_controls

[importlinter:contract:no-microdrop-plugin-internals]
name = Only consts may be imported from Microdrop plugins
type = forbidden
source_modules =
    heater_controller
    heater_controls_ui
    heater_protocol_controls
forbidden_modules =
    device_viewer
    dropbot_controller
    dropbot_preferences_ui
    dropbot_protocol_controls
    dropbot_status_and_controls
    dropbot_tools_menu
    electrode_controller
    manual_controls
    microdrop_application
    microdrop_status_bar
    plugin_management
ignore_imports =
    ** -> *.consts
    ** -> microdrop_application.helpers
    ** -> microdrop_application.dialogs.**
    # --- seeded debt: existing violations, may only shrink ---
    # menus.is_advanced_mode() gate for the compensation feature: the
    # setpoint-compensation controls only apply in Advanced Mode. Should
    # switch to a published topic/consts flag instead of reaching into
    # microdrop_application.menus directly.
    heater_controller.compensation -> microdrop_application.menus
    heater_controls_ui.preferences -> microdrop_application.menus

[importlinter:contract:plugin-layers]
name = UI and protocol-controls sit above the backend and stay independent
type = layers
layers =
    heater_controls_ui | heater_protocol_controls
    heater_controller
ignore_imports =
    # --- seeded debt: existing violations, may only shrink ---
